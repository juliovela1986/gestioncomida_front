# === URLs de desarrollo ===
# Emulador Android:
#   BACKEND_URL=http://10.0.2.2:8081
#   KEYCLOAK_URL=http://10.0.2.2:8180
# Dispositivo físico en LAN — cambia solo aquí cuando ipconfig muestre otra IPv4:
BACKEND_URL=http://192.168.18.24:8081
KEYCLOAK_URL=http://192.168.18.24:8180
# Alternativa estable con mDNS:
# BACKEND_URL=http://sobremesa.local:8081
# KEYCLOAK_URL=http://sobremesa.local:8180

# === Groq ===
GROQ_API_KEY=your_groq_api_key_here
# Modelo para parsear fechas por voz (default: openai/gpt-oss-20b).
# Alternativa usada en backend: qwen/qwen3.8-27b
# GROQ_DATE_MODEL=openai/gpt-oss-20b
